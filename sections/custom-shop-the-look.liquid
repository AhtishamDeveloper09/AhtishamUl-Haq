{% style %}
  .stl-wrap {
    max-width: 100%;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-inline: 50px;
  }

  .stl-heading {
    font-size: 36px;
    margin: 0 0 30px;
    font-family: 'Lustria';
    line-height: 1.2;
  }

  .stl-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .stl-card {
    position: relative;
    overflow: hidden;
    background: #f4f4f4;
  }

  .stl-card__img {
    display: block;
    width: 100%;
    height: 445px;
    object-fit: cover;
  }

  .stl-card__img--placeholder {
    background: #e2e2e2;
  }

  .stl-plus {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #F8F8F8E5;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ---------- Popup ---------- */
  .stl-popup {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
  }

  .stl-popup.is-open {
    display: block;
  }

  .stl-popup__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.25);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .stl-popup.is-open .stl-popup__overlay {
    opacity: 1;
  }

  .stl-popup__panel {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -48%);
    width: 320px;
    max-height: 88vh;
    overflow-y: auto;
    background: #fff;
    padding: 35px 20px 25px;
    opacity: 0;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .stl-popup.is-open .stl-popup__panel {
    opacity: 1;
    transform: translate(-50%, -50%);
  }

  .stl-popup__close {
    position: absolute;
    top: 13px;
    right: 15px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .stl-popup__media-content{
    display: flex;
    gap: 8px;
  }

  .stl-popup__media img {
    width: 120px;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .stl-popup__title {
    margin: 0 0 12px;
    font-size: 16px;
    line-height: 1.2;
    font-family: 'Jost Light';
    color: #000000;
  }

  .stl-popup__price {
    margin: 0 0 12px;
    font-size: 16px;
    font-family: 'Lustria';
    color: #000000;
    line-height: 1.2;
  }

  .stl-popup__desc {
    font-family: 'Jost Light';
    font-size: 14px;
    margin: 0;
    line-height: 1.1;
    color: #000000;
    letter-spacing: -1%;
  }

  .stl-option {
    margin-top: 12px;
  }

  .stl-option__label {
    font-size: 14px;
    margin: 0 0 6px;
    line-height: 1.4;
    color: #333333;
  }

  /* ---------- Color swatch row with sliding highlight ---------- */
  .stl-swatch-row {
    position: relative;
    display: flex;
    border: 0.5px solid #000000;
  }

  .stl-swatch-highlight {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0;
    background: #000000;
    transition: transform 0.3s ease, width 0.3s ease;
    z-index: 0;
  }

  .stl-swatch {
    position: relative;
    z-index: 1;
    flex: 1;
    padding: 10px 16px;
    background: transparent;
    border: none;
    border-right: 0.5px solid #000000;
    font-size: 18px;
    line-height: 1;
    letter-spacing: -2%;
    cursor: pointer;
    color: #000000;
    text-align: left;
    transition: color 0.3s ease;
    font-family: "Jost";
  }

  .stl-swatch:last-child {
    border-right: none;
  }

  .stl-swatch.is-active {
    color: #fff;
  }

  .stl-swatch__label {
    display: block;
  }

  .stl-swatch__color-line {
    display: block;
    width: 6px;
    height: 103%;
    position: absolute;
    top: -1px;
    left: -1px;
    border: 0.5px solid black;
  }

  /* ---------- Size dropdown ---------- */
  .stl-size {
    position: relative;
  }

  .stl-size__toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0;
    background: #fff;
    border: 0.5px solid #000000;
    font-size: 16px;
    line-height: 1;
    letter-spacing: -2%;
    cursor: pointer;
    height: 40px;
    font-family: "Jost";
  }

  .stl-size__toggle span:first-child {
    padding: 0 13px;
  }

  .stl-size__toggle span:last-child {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0 17px;
    border-left: 0.5px solid #000000;
    height: 100%;
  }

  .stl-size__toggle svg {
    transition: transform 0.3s ease;
  }

  .stl-size.is-open .stl-size__toggle svg {
    transform: rotate(180deg);
  }

  .stl-size__list {
    list-style: none;
    margin: 0;
    margin-top: -1px;
    padding: 0;
    border: 1px solid #000000;
    max-height: 0;
    overflow-y: scroll;
    scrollbar-width: none;
    opacity: 0;
    transition: max-height 0.28s ease, opacity 0.2s ease;
    position: absolute;
    width: 100%;
  }

  .stl-size.is-open .stl-size__list {
    max-height: 100px;
    opacity: 1;
  }

  .stl-size__option {
    display: block;
    width: 100%;
    text-align: center;
    padding: 10px 12px;
    background: #fff;
    border: none;
    font-size: 16px;
    line-height: 1;
    letter-spacing: -2%;
    cursor: pointer;
    transition: background-color 0.3s ease, color 0.3s ease;
    font-family: "Jost";
  }

  .stl-size__option:hover {
    background: #111;
    color: #fff;
  }

  .stl-generic-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .stl-generic-option {
    padding: 8px 12px;
    border: 1px solid #ccc;
    background: #fff;
    font-size: 13px;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .stl-generic-option.is-active {
    background: #111;
    color: #fff;
    border-color: #111;
  }

  .stl-add-to-cart {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 45px;
    background: #000000;
    color: #fff;
    border: none;
    font-size: 16px;
    cursor: pointer;
    margin-top: 50px;
    text-transform: uppercase;
    transition: opacity 0.3s ease;
    padding-left: 40px;
    gap: 28px;
    font-family: "Jost";
  }

  .stl-add-to-cart:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .stl-form__message {
    font-size: 12px;
    margin: 8px 0 0;
    min-height: 14px;
  }

  .stl-form__message.is-error {
    color: #c0392b;
  }

  .stl-form__message.is-success {
    color: #1e7e34;
  }

  @media screen and (max-width: 1024px) {
    .stl-wrap {
      padding-top: 60px;
      padding-bottom: 35px;
      padding-inline: 30px;
    }

    .stl-heading {
      font-size: 32px;
      margin: 0 0 26px;
    }

    .stl-card__img {
      height: 360px;
    }
  }

  @media screen and (max-width: 768px) {
    .stl-wrap {
      padding-top: 40px;
      padding-bottom: 24px;
      padding-inline: 16.5px;
    }

    .stl-heading {
      font-size: 24px;
      margin: 0 0 20px;
      text-align: center;
    }

    .stl-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 4px;
    }

    .stl-card__img {
      height: 186px;
    }

    .stl-plus {
      width: 16px;
      height: 16px;
      padding: 4.5px;
    }

    .stl-popup__desc {
      font-size: 12px;
    }
  }
{% endstyle %}

<div class="stl-wrap" data-section="{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="stl-heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="stl-grid">
    {%- for block in section.blocks -%}
      {%- assign product = block.settings.product -%}
      <div class="stl-card" {{ block.shopify_attributes }}>
        {%- if product != blank -%}
          {%- if product.featured_image != blank -%}
            <img
              class="stl-card__img"
              src="{{ product.featured_image | image_url: width: 800 }}"
              srcset="{{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 800 }} 800w"
              sizes="(max-width: 749px) 50vw, 33vw"
              alt="{{ product.featured_image.alt | escape }}"
              loading="lazy"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
            >
          {%- else -%}
            <div class="stl-card__img stl-card__img--placeholder">&nbsp</div>
          {%- endif -%}

          <button
            type="button"
            class="stl-plus"
            style="top: {% if block.settings.icon_v_position == 'top' %}{{ block.settings.icon_v_offset }}%{% else %}auto{% endif %}; bottom: {% if block.settings.icon_v_position == 'bottom' %}{{ block.settings.icon_v_offset }}%{% else %}auto{% endif %}; left: {% if block.settings.icon_h_position == 'left' %}{{ block.settings.icon_h_offset }}%{% else %}auto{% endif %}; right: {% if block.settings.icon_h_position == 'right' %}{{ block.settings.icon_h_offset }}%{% else %}auto{% endif %};"
            data-stl-open="stl-popup-{{ section.id }}-{{ forloop.index }}"
            aria-label="{{ 'products.product.choose_options' | t | default: 'View product options' }}"
          >
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4.98047 0.75V9.21154" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
              <path d="M0.75 4.98071H9.21154" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
            </svg>
          </button>
        {%- else -%}
          <div class="stl-card__img stl-card__img--placeholder"></div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  {%- comment -%} Popups — one per block, rendered outside the grid flow {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- assign product = block.settings.product -%}
    {%- if product != blank -%}
      <div class="stl-popup" id="stl-popup-{{ section.id }}-{{ forloop.index }}" data-stl-popup>
        <div class="stl-popup__overlay" data-stl-close>&nbsp</div>
        <div class="stl-popup__panel" role="dialog" aria-modal="true">
          <button
            type="button"
            class="stl-popup__close"
            data-stl-close
            aria-label="{{ 'accessibility.close' | t | default: 'Close' }}"
          >
            <svg width="16" height="16" viewBox="0 0 17 17" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4.24219 4.24279L12.7275 12.7281" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
              <path d="M4.24219 12.7278L12.7275 4.24249" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
            </svg>
          </button>

          <div class="stl-popup__media-content">
            <div class="stl-popup__media">
              {%- if product.featured_image != blank -%}
                <img
                  src="{{ product.featured_image | image_url: width: 500 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy"
                >
              {%- endif -%}
            </div>
            <div class="stl-product__info">
              <h3 class="stl-popup__title">{{ product.title }}</h3>
              <p class="stl-popup__price">{{ product.price | money }}</p>
              {%- if product.description != blank -%}
                <p class="stl-popup__desc">{{ product.description | strip_html | truncatewords: 28 }}</p>
              {%- endif -%}
            </div>
          </div>

          <div class="stl-popup__info">
            <form
              class="stl-form"
              data-stl-form
              data-bonus-id="{{ block.settings.bonus_product.selected_or_first_available_variant.id }}"
              data-bonus-color="{{ block.settings.bonus_trigger_color | escape }}"
              data-bonus-size="{{ block.settings.bonus_trigger_size | escape }}"
            >
              {%- for option in product.options_with_values -%}
                {%- assign option_name_down = option.name | downcase -%}
                <div class="stl-option" data-option-position="{{ option.position }}">
                  <p class="stl-option__label">{{ option.name }}</p>

                  {%- if option_name_down contains 'color' or option_name_down contains 'colour' -%}
                    <div class="stl-swatch-row" data-stl-swatches>
                      <span class="stl-swatch-highlight" data-stl-highlight></span>
                      {%- for value in option.values -%}
                        <button type="button" class="stl-swatch" data-value="{{ value | escape }}">
                          <span class="stl-swatch__label">{{ value }}</span>
                          <span
                            class="stl-swatch__color-line"
                            style="background-color: {{ value | downcase | strip }};"
                          ></span>
                        </button>
                      {%- endfor -%}
                    </div>

                  {%- elsif option_name_down contains 'size' -%}
                    <div class="stl-size" data-stl-size>
                      <button type="button" class="stl-size__toggle" data-stl-size-toggle>
                        <span data-stl-size-label> Choose your size </span>
                        <span>
                          <svg width="15" height="9" viewBox="0 0 15 9" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M1.06067 1.06067L7.06067 7.06067L13.0607 1.06067" stroke="black" stroke-width="1.5" stroke-linecap="square"/>
                          </svg>
                        </span>
                      </button>
                      <ul class="stl-size__list" data-stl-size-list>
                        {%- for value in option.values -%}
                          <li>
                            <button type="button" class="stl-size__option" data-value="{{ value | escape }}">
                              {{ value }}
                            </button>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>

                  {%- else -%}
                    <div class="stl-generic-row" data-stl-generic>
                      {%- for value in option.values -%}
                        <button type="button" class="stl-generic-option" data-value="{{ value | escape }}">
                          {{ value }}
                        </button>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endfor -%}

              <button type="submit" class="stl-add-to-cart" data-stl-add>
                <span data-stl-add-label>{{ 'products.product.add_to_cart' | t | default: 'ADD TO CART' }}</span>
                <svg width="36" height="12" viewBox="0 0 36 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M0.75 4.77295L9.20657e-08 4.77295L-9.20657e-08 6.27295L0.75 6.27295L0.75 4.77295ZM34.9798 6.05328C35.2727 5.76039 35.2727 5.28551 34.9798 4.99262L30.2068 0.21965C29.9139 -0.0732432 29.4391 -0.0732433 29.1462 0.21965C28.8533 0.512544 28.8533 0.987417 29.1462 1.28031L33.3888 5.52295L29.1462 9.76559C28.8533 10.0585 28.8533 10.5334 29.1462 10.8263C29.4391 11.1191 29.9139 11.1191 30.2068 10.8263L34.9798 6.05328ZM0.75 6.27295L34.4495 6.27295L34.4495 4.77295L0.75 4.77295L0.75 6.27295Z" fill="white"/>
                </svg>
              </button>
              <p class="stl-form__message" data-stl-message role="status" aria-live="polite"></p>
            </form>

            <script type="application/json" data-stl-variants>
              {{ product.variants | json }}
            </script>
          </div>
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>

<script>
  (function () {
    'use strict';
    
    function refreshCartDrawer() {
      var liveDrawer = document.querySelector('cart-drawer');
      if (!liveDrawer) return Promise.resolve();

      return fetch(window.location.pathname + '?sections=cart-drawer,cart-icon-bubble')
        .then(function (res) {
          return res.json();
        })
        .then(function (data) {
          if (data['cart-drawer']) {
            var temp = document.createElement('div');
            temp.innerHTML = data['cart-drawer'];

            var freshInner = temp.querySelector('.drawer__inner');
            var liveInner = liveDrawer.querySelector('.drawer__inner');

            if (freshInner && liveInner) {
              liveInner.innerHTML = freshInner.innerHTML;
            } else {
              var freshDrawerTag = temp.querySelector('cart-drawer');
              liveDrawer.innerHTML = freshDrawerTag ? freshDrawerTag.innerHTML : data['cart-drawer'];
            }

            liveDrawer.classList.remove('is-empty');
          }

          if (data['cart-icon-bubble']) {
            var bubble = document.getElementById('cart-icon-bubble');
            if (bubble) bubble.innerHTML = data['cart-icon-bubble'];
          }

          if (typeof liveDrawer.open === 'function') {
            liveDrawer.open();
          } else {
            liveDrawer.classList.add('active');
            document.body.style.overflow = 'hidden';
          }
        });
    }

    document.addEventListener('click', function (e) {
      var opener = e.target.closest('[data-stl-open]');
      if (opener) {
        var popup = document.getElementById(opener.getAttribute('data-stl-open'));
        if (popup) openPopup(popup);
      }

      var closer = e.target.closest('[data-stl-close]');
      if (closer) {
        var openPop = closer.closest('.stl-popup');
        if (openPop) closePopup(openPop);
      }

      // Safety net: any click outside the popup panel closes whichever popup
      // is currently open, even if it didn't land on the overlay itself.
      document.querySelectorAll('.stl-popup.is-open').forEach(function (popup) {
        var panel = popup.querySelector('.stl-popup__panel');
        var clickedOpener = e.target.closest('[data-stl-open]');
        if (panel && !panel.contains(e.target) && !clickedOpener) {
          closePopup(popup);
        }
      });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        document.querySelectorAll('.stl-popup.is-open').forEach(closePopup);
      }
    });

    function openPopup(popup) {
      popup.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closePopup(popup) {
      popup.classList.remove('is-open');
      if (!document.querySelector('.stl-popup.is-open')) {
        document.body.style.overflow = '';
      }
    }

    // Initialize each popup's interactive form once, on first open
    var initialized = new WeakSet();
    document.addEventListener('click', function (e) {
      var opener = e.target.closest('[data-stl-open]');
      if (!opener) return;
      var popup = document.getElementById(opener.getAttribute('data-stl-open'));
      if (popup && !initialized.has(popup)) {
        initPopup(popup);
        initialized.add(popup);
      }
    });

    function initPopup(popup) {
      var form = popup.querySelector('[data-stl-form]');
      if (!form) return;

      var variantsScript = popup.querySelector('[data-stl-variants]');
      var variants = [];
      try {
        variants = JSON.parse(variantsScript.textContent);
      } catch (err) {
        variants = [];
      }

      var selected = {}; // { "1": "Blue", "2": "S" }

      // ---- Color swatches ----
      var swatchRow = form.querySelector('[data-stl-swatches]');
      if (swatchRow) {
        var highlight = swatchRow.querySelector('[data-stl-highlight]');
        var swatchButtons = Array.prototype.slice.call(swatchRow.querySelectorAll('.stl-swatch'));
        var position = swatchRow.closest('[data-option-position]').getAttribute('data-option-position');

        swatchButtons.forEach(function (btn, index) {
          btn.addEventListener('click', function () {
            swatchButtons.forEach(function (b) {
              b.classList.remove('is-active');
            });
            btn.classList.add('is-active');
            selected[position] = btn.getAttribute('data-value');
            moveHighlight(btn);
            updateAddButtonState();
          });
        });

        function moveHighlight(btn) {
          highlight.style.width = btn.offsetWidth + 'px';
          highlight.style.transform = 'translateX(' + btn.offsetLeft + 'px)';
        }
      }

      // ---- Size dropdown (custom state machine) ----
      var sizeWrap = form.querySelector('[data-stl-size]');
      if (sizeWrap) {
        var toggle = sizeWrap.querySelector('[data-stl-size-toggle]');
        var label = sizeWrap.querySelector('[data-stl-size-label]');
        var list = sizeWrap.querySelector('[data-stl-size-list]');
        var options = Array.prototype.slice.call(sizeWrap.querySelectorAll('.stl-size__option'));
        var sizePosition = sizeWrap.closest('[data-option-position]').getAttribute('data-option-position');
        var placeholder = label.textContent;
        var committedValue = null;
        var isOpen = false;

        toggle.addEventListener('click', function (e) {
          e.stopPropagation();
          if (!isOpen) {
            openList();
          } else {
            closeListAndReset();
          }
        });

        options.forEach(function (opt) {
          opt.addEventListener('click', function (e) {
            e.stopPropagation();
            committedValue = opt.getAttribute('data-value');
            selected[sizePosition] = committedValue;
            label.textContent = committedValue;
            closeList();
            updateAddButtonState();
          });
        });

        document.addEventListener('click', function (e) {
          if (isOpen && !sizeWrap.contains(e.target)) {
            closeListAndReset();
          }
        });

        function openList() {
          isOpen = true;
          sizeWrap.classList.add('is-open');
          label.textContent = placeholder; // per spec: always shows placeholder while open
        }

        function closeList() {
          isOpen = false;
          sizeWrap.classList.remove('is-open');
        }

        function closeListAndReset() {
          // closing without an explicit selection clears any prior committed value
          committedValue = null;
          delete selected[sizePosition];
          label.textContent = placeholder;
          closeList();
          updateAddButtonState();
        }
      }

      // ---- Generic (fallback) options, e.g. a 3rd option ----
      var genericRows = form.querySelectorAll('[data-stl-generic]');
      genericRows.forEach(function (row) {
        var pos = row.closest('[data-option-position]').getAttribute('data-option-position');
        var buttons = Array.prototype.slice.call(row.querySelectorAll('.stl-generic-option'));
        buttons.forEach(function (btn) {
          btn.addEventListener('click', function () {
            buttons.forEach(function (b) {
              b.classList.remove('is-active');
            });
            btn.classList.add('is-active');
            selected[pos] = btn.getAttribute('data-value');
            updateAddButtonState();
          });
        });
      });

      var totalOptionGroups = form.querySelectorAll('[data-option-position]').length;
      var addBtn = form.querySelector('[data-stl-add]');
      var addLabel = form.querySelector('[data-stl-add-label]');
      var message = form.querySelector('[data-stl-message]');
      var defaultLabel = addLabel.textContent;

      function updateAddButtonState() {
        // purely visual — full validation happens on submit too
        message.textContent = '';
        message.className = 'stl-form__message';
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();

        var selectedCount = Object.keys(selected).length;
        if (selectedCount < totalOptionGroups) {
          message.textContent = 'Please select all options.';
          message.className = 'stl-form__message is-error';
          return;
        }

        var variant = variants.find(function (v) {
          return (
            (v.option1 === undefined || v.option1 === selected['1']) &&
            (v.option2 === undefined || selected['2'] === undefined || v.option2 === selected['2']) &&
            (v.option3 === undefined || selected['3'] === undefined || v.option3 === selected['3'])
          );
        });

        if (!variant || !variant.available) {
          message.textContent = 'That combination is unavailable.';
          message.className = 'stl-form__message is-error';
          return;
        }

        var items = [{ id: variant.id, quantity: 1 }];

        var bonusId = form.getAttribute('data-bonus-id');
        var bonusColor = form.getAttribute('data-bonus-color');
        var bonusSize = form.getAttribute('data-bonus-size');

        if (bonusId && bonusColor && bonusSize) {
          var colorMatches = Object.values(selected).indexOf(bonusColor) !== -1;
          var sizeMatches = Object.values(selected).indexOf(bonusSize) !== -1;
          if (colorMatches && sizeMatches) {
            items.push({ id: parseInt(bonusId, 10), quantity: 1 });
          }
        }

        addBtn.disabled = true;
        addLabel.textContent = 'Adding...';

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items: items }),
        })
          .then(function (res) {
            if (!res.ok)
              return res.json().then(function (err) {
                throw err;
              });
            return res.json();
          })
          .then(function () {
            message.textContent = items.length > 1 ? 'Added to cart (bundle included).' : 'Added to cart.';
            message.className = 'stl-form__message is-success';
            return refreshCartDrawer();
          })
          .then(function () {
            document.dispatchEvent(new CustomEvent('cart:refresh'));
            addBtn.disabled = false;
            addLabel.textContent = defaultLabel;
          })
          .catch(function (err) {
            message.textContent = (err && err.description) || 'Could not add to cart.';
            message.className = 'stl-form__message is-error';
            addBtn.disabled = false;
            addLabel.textContent = defaultLabel;
          });
      });
    }
  })();
</script>

